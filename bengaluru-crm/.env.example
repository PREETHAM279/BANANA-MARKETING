# Copy this file to .env.local and fill in only what you need. .env.local is never committed.
# All keys below are OPTIONAL - the CRM works fully without them.

# Google Places API (New) - adds Google rating, review count, Maps link and photos to profiles.
# Create a key at https://console.cloud.google.com/ (enable "Places API (New)"), restrict it to that API.
GOOGLE_PLACES_API_KEY=

# SMTP - lets the CRM actually send emails (e.g. Gmail with an App Password, Zoho, Outlook).
# Without it, the email button opens your Mail app / Gmail with the message pre-filled.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Port for the local website (default 3100). Change only if 3100 is busy.
CRM_PORT=3100
